# EdgeOne 正式域名确定后填写；仅用于构建绝对 metadata URL。
SITE_ORIGIN=https://blog.example.com

# 后台 /admin 登录。填在 EdgeOne 项目环境变量和本地 .env.local，不要加 NEXT_PUBLIC_。
# ADMIN_TOTP_SECRET 是验证器里的 Base32 密钥，不是每次登录输入的 6 位码。
# 生成密钥和 otpauth 链接：node scripts/dev/print-totp-setup.mjs
# 线上修改后需要一次新的部署才会进入函数。
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_TOTP_SECRET=
